# Servidor
PORT=3000
NODE_ENV=development

# Base de datos
MONGODB_URI=mongodb://localhost:27017/ricoquiz-plus

# Sesión (JWT)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# Cliente Angular y CORS
# CLIENT_URL: a dónde apunta el link de activación del correo
CLIENT_URL=http://localhost:4200
# Orígenes permitidos (REST y sockets), separados por coma. Acepta * para los deploy previews de Netlify
CORS_ORIGIN=http://localhost:4200
# Producción: CORS_ORIGIN=https://ricoquiz.netlify.app,https://*--ricoquiz.netlify.app

# URL pública de esta API (Swagger la usa como servidor)
APP_BASE_URL=http://localhost:3000

# Google Identity Services (solo el Client ID; ya no se usa client secret ni sesiones)
GOOGLE_CLIENT_ID=

# Activación de cuenta por correo
# false (default): las cuentas se crean activas. true: hay que activar por correo antes del login
REQUIRE_EMAIL_ACTIVATION=false
ACTIVATION_TOKEN_SECRET=change-me-in-production
ACTIVATION_TOKEN_EXPIRES_IN=1d

# Envío de correo: si hay BREVO_API_KEY se usa Brevo por HTTPS (funciona en Render); si no, SMTP de Gmail
MAIL_FROM=tu-correo@gmail.com
BREVO_API_KEY=
SMTP_USER=tu-correo@gmail.com
SMTP_PASS=tu-app-password-de-gmail

# IA - Generación de preguntas (Gemini)
GEMINI_API_KEY=

# Almacenamiento en la nube (imágenes)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
